<?xml version="1.0" encoding="utf-8"?>
<!--
    Item de anotação para o RecyclerView.
    Exibe título, data e chevron de navegação.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_nota"
    android:padding="16dp"
    android:layout_marginBottom="8dp">

    <!-- Título da anotação -->
    <TextView
        android:id="@+id/tvTituloAnotacao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="REST API Concepts"
        android:textColor="@color/texto_primario"
        android:textSize="15sp"
        android:textStyle="bold"
        android:fontFamily="@font/inter_medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Data da anotação -->
    <TextView
        android:id="@+id/tvDataAnotacao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="24 de Outubro, 2023"
        android:textColor="@color/texto_hint"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTituloAnotacao" />

</androidx.constraintlayout.widget.ConstraintLayout>
