<?xml version="1.0" encoding="utf-8"?>
<!--
    TELA 11: Menu Institucional — menu lateral com perfil, links e opção de sair.
    Card do usuário no topo, lista de itens e botão "Sair" em vermelho.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_tela">

    <!-- Card do usuário no topo -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardUsuario"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/fundo_card"
        android:padding="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Avatar circular -->
        <ImageView
            android:id="@+id/imgAvatarMenu"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_avatar"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_myplaces"
            android:tint="@color/roxo_primario"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Nome do usuário -->
        <TextView
            android:id="@+id/tvNomeUsuario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Carlos Eduardo Silva"
            android:textColor="@color/texto_primario"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/inter_medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imgAvatarMenu"
            app:layout_constraintTop_toTopOf="@id/imgAvatarMenu" />

        <!-- E-mail do usuário -->
        <TextView
            android:id="@+id/tvEmailUsuario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:text="carlos.eduardo@smartcaderno.com"
            android:textColor="@color/texto_secundario"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imgAvatarMenu"
            app:layout_constraintTop_toBottomOf="@id/tvNomeUsuario" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Itens do menu -->
    <LinearLayout
        android:id="@+id/layoutItensMenu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@color/fundo_card"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardUsuario">

        <!-- Item: Editar Perfil -->
        <LinearLayout
            android:id="@+id/itemEditarPerfil"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_editar"
                android:tint="@color/texto_secundario" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Editar Perfil"
                android:textColor="@color/texto_primario"
                android:textSize="15sp" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/divisoria" android:layout_marginHorizontal="20dp"/>

        <!-- Item: Sobre o Aplicativo -->
        <LinearLayout
            android:id="@+id/itemSobre"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="16dp"
                android:src="@android:drawable/ic_dialog_info"
                android:tint="@color/texto_secundario" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sobre o Aplicativo"
                android:textColor="@color/texto_primario"
                android:textSize="15sp" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/divisoria" android:layout_marginHorizontal="20dp"/>

        <!-- Item: Guia de Produtividade -->
        <LinearLayout
            android:id="@+id/itemGuia"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="16dp"
                android:src="@android:drawable/ic_menu_help"
                android:tint="@color/texto_secundario" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Guia de Produtividade"
                android:textColor="@color/texto_primario"
                android:textSize="15sp" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/divisoria" android:layout_marginHorizontal="20dp"/>

        <!-- Item: Termos de Uso -->
        <LinearLayout
            android:id="@+id/itemTermos"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="16dp"
                android:src="@android:drawable/ic_menu_agenda"
                android:tint="@color/texto_secundario" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Termos de Uso"
                android:textColor="@color/texto_primario"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Botão Sair (vermelho) -->
    <LinearLayout
        android:id="@+id/itemSair"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:background="@color/fundo_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutItensMenu">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sair"
            android:textColor="@color/cor_erro"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Barra de navegação inferior (Menu destacado) -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/fundo_card"
        app:menu="@menu/menu_bottom_nav"
        app:itemTextColor="@color/bottom_nav_color"
        app:itemIconTint="@color/bottom_nav_color"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
