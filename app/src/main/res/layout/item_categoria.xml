<?xml version="1.0" encoding="utf-8"?>
<!--
    ITEM da lista de categorias (usado pelo RecyclerView em CategoriasActivity)
    Exibe: emoji da categoria, nome, descrição e quantidade de notas.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_nota"
    android:paddingHorizontal="16dp"
    android:elevation="2dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <!-- Círculo com emoji da categoria (fundo roxo claro) -->
    <TextView
        android:id="@+id/tv_icone_categoria"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:gravity="center"
        android:background="@drawable/bg_tag_categoria"
        android:text="📚"
        android:textSize="22sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Nome da categoria -->
    <TextView
        android:id="@+id/tv_nome_categoria"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Estudo"
        android:textColor="@color/texto_primario"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="@font/inter_medium"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/tv_sub_categoria"
        app:layout_constraintStart_toEndOf="@+id/tv_icone_categoria"
        app:layout_constraintEnd_toStartOf="@+id/tv_qtd_cat"
        app:layout_constraintVertical_chainStyle="packed" />

    <!-- Descrição/subtítulo da categoria -->
    <TextView
        android:id="@+id/tv_sub_categoria"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        android:text="Notas de aula e revisões"
        android:textColor="@color/texto_hint"
        android:textSize="12sp"
        android:fontFamily="@font/inter"
        app:layout_constraintTop_toBottomOf="@+id/tv_nome_categoria"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_icone_categoria"
        app:layout_constraintEnd_toStartOf="@+id/tv_qtd_cat" />

    <!-- Contador de notas na categoria (alinhado à direita) -->
    <TextView
        android:id="@+id/tv_qtd_cat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="5 notas"
        android:textColor="@color/roxo_primario"
        android:textSize="12sp"
        android:fontFamily="@font/inter_medium"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
