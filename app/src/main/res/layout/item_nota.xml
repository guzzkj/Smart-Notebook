<?xml version="1.0" encoding="utf-8"?>
<!--
    ITEM da lista de anotações (usado pelo RecyclerView em NotasActivity, FavoritosActivity e BuscaActivity)
    Exibe: título, prévia do conteúdo, categoria, data e ícone de favorito.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_nota"
    android:padding="16dp"
    android:elevation="2dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <!-- Título da anotação (uma linha com reticências se for longo) -->
    <TextView
        android:id="@+id/tv_titulo_nota"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Título da Anotação"
        android:textColor="@color/texto_primario"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="@font/inter_medium"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/img_favorito" />

    <!-- Ícone de favorito (estrela cheia ou vazia) -->
    <ImageView
        android:id="@+id/img_favorito"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@android:drawable/btn_star_big_off"
        android:contentDescription="Favorito"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Prévia do conteúdo da nota (máximo 2 linhas) -->
    <TextView
        android:id="@+id/tv_preview_conteudo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Prévia do conteúdo..."
        android:textColor="@color/texto_secundario"
        android:textSize="13sp"
        android:fontFamily="@font/inter"
        android:maxLines="2"
        android:ellipsize="end"
        app:layout_constraintTop_toBottomOf="@+id/tv_titulo_nota"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Etiqueta de categoria (tag roxa arredondada) -->
    <TextView
        android:id="@+id/tv_categoria_nota"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_tag_categoria"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="Estudo"
        android:textColor="@color/roxo_primario"
        android:textSize="11sp"
        android:fontFamily="@font/inter_medium"
        app:layout_constraintTop_toBottomOf="@+id/tv_preview_conteudo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Data da nota (alinhada à direita, mesma linha da categoria) -->
    <TextView
        android:id="@+id/tv_data_nota"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="01/01/2025"
        android:textColor="@color/texto_hint"
        android:textSize="11sp"
        android:fontFamily="@font/inter"
        app:layout_constraintTop_toBottomOf="@+id/tv_preview_conteudo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
