<?xml version="1.0" encoding="utf-8"?>
<!--
    TELA 1 – Splash Screen
    Exibida ao abrir o app por 2 segundos antes de ir para o Login.
    Usa fundo gradiente roxo com logo e slogan centralizados.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash">

    <!-- Logo do aplicativo, centralizado na tela -->
    <ImageView
        android:id="@+id/img_logo_splash"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_logo"
        android:contentDescription="Logo Smart Notebook"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/tv_app_name_splash"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.42" />

    <!-- Nome do aplicativo -->
    <TextView
        android:id="@+id/tv_app_name_splash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Smart Notebook"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"
        android:fontFamily="@font/inter_medium"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/img_logo_splash"
        app:layout_constraintBottom_toTopOf="@+id/tv_slogan"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Slogan do app -->
    <TextView
        android:id="@+id/tv_slogan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Organize suas ideias com inteligência"
        android:textColor="#DDEEFF"
        android:textSize="15sp"
        android:fontFamily="@font/inter"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_app_name_splash"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Indicador de carregamento na parte inferior -->
    <ProgressBar
        android:id="@+id/progress_splash"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminateTint="#FFFFFF"
        android:layout_marginBottom="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
