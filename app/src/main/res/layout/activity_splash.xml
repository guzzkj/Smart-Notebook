<?xml version="1.0" encoding="utf-8"?>
<!--
    TELA 1 – Splash Screen
    Exibida ao abrir o app por 2 segundos antes de ir para o Login.
    Usa fundo sólido azul-ardósia com logo, slogan, barra de progresso e versão.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash">

    <!-- Logo do aplicativo (ic_logo já inclui o container arredondado azul) -->
    <ImageView
        android:id="@+id/img_logo_splash"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@drawable/ic_logo"
        android:contentDescription="Logo Smart Notebook"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/tv_app_name_splash"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.42" />

    <!-- Nome do aplicativo -->
    <TextView
        android:id="@+id/tv_app_name_splash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Smart Notebook"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"
        android:fontFamily="@font/inter_medium"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@+id/img_logo_splash"
        app:layout_constraintBottom_toTopOf="@+id/tv_slogan"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Slogan do app -->
    <TextView
        android:id="@+id/tv_slogan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Seu Caderno Inteligente"
        android:textColor="#CCFFFFFF"
        android:textSize="15sp"
        android:fontFamily="@font/inter"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_app_name_splash"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Barra de progresso linear horizontal na parte inferior -->
    <ProgressBar
        android:id="@+id/progress_splash"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="240dp"
        android:layout_height="6dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="33"
        android:progressTint="#FFFFFF"
        android:progressBackgroundTint="#33FFFFFF"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_versao"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Texto de versão no rodapé -->
    <TextView
        android:id="@+id/tv_versao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VERSION 2.0"
        android:textColor="#99FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:fontFamily="@font/inter"
        android:layout_marginBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
