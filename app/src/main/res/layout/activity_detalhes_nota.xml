<?xml version="1.0" encoding="utf-8"?>
<!--
    TELA 6 – Detalhes de uma Anotação
    Exibe o conteúdo completo da nota.
    A Toolbar possui Options Menu (editar, favoritar, excluir).
    Recebe o ID da nota via Intent extra (DetalhesNotaActivity.EXTRA_NOTA_ID).
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_tela">

    <!-- Toolbar com botão voltar e menu de ações (menu_detalhes.xml) -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_detalhes"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/roxo_primario"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="Voltar"
        app:title="Detalhes"
        app:titleTextColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Área rolável com o conteúdo completo da nota -->
    <ScrollView
        android:id="@+id/scroll_detalhes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_detalhes"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="32dp">

            <!-- Etiqueta de categoria da nota -->
            <TextView
                android:id="@+id/tv_categoria_detalhe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_categoria"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="Estudo"
                android:textColor="@color/roxo_primario"
                android:textSize="12sp"
                android:fontFamily="@font/inter_medium"
                android:layout_marginBottom="16dp" />

            <!-- Título da anotação em destaque -->
            <TextView
                android:id="@+id/tv_titulo_detalhe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Título da Anotação"
                android:textColor="@color/texto_primario"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_medium"
                android:layout_marginBottom="8dp" />

            <!-- Linha com ícone de data + data de criação -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@android:drawable/ic_menu_recent_history"
                    android:contentDescription="Data" />

                <TextView
                    android:id="@+id/tv_data_detalhe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="01 de Janeiro de 2025"
                    android:textColor="@color/texto_hint"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter" />
            </LinearLayout>

            <!-- Linha divisória horizontal -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divisoria"
                android:layout_marginBottom="20dp" />

            <!-- Conteúdo completo da anotação (texto longo) -->
            <TextView
                android:id="@+id/tv_conteudo_detalhe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="O conteúdo da anotação será exibido aqui. Pode ser um texto longo com várias linhas e parágrafos sobre o assunto estudado ou anotado pelo usuário."
                android:textColor="@color/texto_primario"
                android:textSize="16sp"
                android:lineSpacingExtra="6dp"
                android:fontFamily="@font/inter" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
