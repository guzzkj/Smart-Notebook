<?xml version="1.0" encoding="utf-8"?>
<!--
    TELA 8: Nova Anotação — editor de texto com título e conteúdo.
    Header com voltar e botão de salvar. Barra de formatação no rodapé.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_card">

    <!-- Header: voltar + título da tela + botão salvar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutHeader"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/fundo_card"
        android:elevation="4dp"
        android:paddingHorizontal="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Botão voltar: 40dp para área de toque adequada e ícone bem centralizado -->
        <ImageButton
            android:id="@+id/btnVoltar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:scaleType="centerInside"
            android:padding="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Título da tela: preenche o espaço entre os dois botões, texto centralizado -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Nova Anotação"
            android:textColor="@color/texto_primario"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/inter_medium"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnSalvar"
            app:layout_constraintStart_toEndOf="@id/btnVoltar"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Botão salvar: circular com fundo roxo claro e ícone check centralizado -->
        <ImageButton
            android:id="@+id/btnSalvar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_btn_salvar"
            android:src="@drawable/ic_check_circle"
            android:tint="@color/roxo_primario"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:contentDescription="Salvar anotação"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Campo de título da anotação -->
    <EditText
        android:id="@+id/etTituloAnotacao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:background="@null"
        android:hint="Título da Anotação"
        android:inputType="textCapSentences"
        android:textColor="@color/texto_primario"
        android:textColorHint="@color/texto_hint"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader" />

    <!-- Divisor entre título e conteúdo -->
    <View
        android:id="@+id/divisor"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/divisoria"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etTituloAnotacao" />

    <!-- Campo de conteúdo da anotação: ocupa todo o espaço restante -->
    <EditText
        android:id="@+id/etConteudoAnotacao"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:background="@null"
        android:gravity="top"
        android:hint="Comece a escrever sua nota aqui..."
        android:inputType="textCapSentences|textMultiLine"
        android:textColor="@color/texto_primario"
        android:textColorHint="@color/texto_hint"
        android:textSize="15sp"
        app:layout_constraintBottom_toTopOf="@id/barraFormatacao"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divisor" />

    <!-- Barra de formatação fixada no rodapé -->
    <LinearLayout
        android:id="@+id/barraFormatacao"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@color/fundo_tela"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Botão Negrito: TextView clicável para garantir textStyle="bold" sem interferência do Material3 -->
        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="B"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/texto_secundario" />

        <!-- Botão Itálico: TextView clicável para garantir renderização do textStyle="italic" -->
        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="I"
            android:textStyle="italic"
            android:textSize="16sp"
            android:textColor="@color/texto_secundario" />

        <!-- Separador vertical entre grupo de texto e grupo de listas -->
        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_marginHorizontal="6dp"
            android:background="@color/divisoria" />

        <!-- Botão Lista com marcadores -->
        <ImageButton
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_lista"
            android:scaleType="centerInside"
            android:tint="@color/texto_secundario" />

        <!-- Botão Checklist -->
        <ImageButton
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_checklist"
            android:scaleType="centerInside"
            android:tint="@color/texto_secundario" />

        <!-- Separador vertical entre grupo de listas e grupo de mídia -->
        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_marginHorizontal="6dp"
            android:background="@color/divisoria" />

        <!-- Botão Inserir Imagem -->
        <ImageButton
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_imagem"
            android:scaleType="centerInside"
            android:tint="@color/texto_secundario" />

        <!-- Espaçador: empurra o botão de mais opções para a direita -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Botão Mais opções (alinhado à direita) -->
        <ImageButton
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_mais_opcoes"
            android:scaleType="centerInside"
            android:tint="@color/texto_secundario" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
