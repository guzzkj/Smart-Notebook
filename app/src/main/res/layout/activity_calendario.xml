<?xml version="1.0" encoding="utf-8"?>
<!--
    TELA 11: Calendário — visualização mensal com eventos e atividades.
    Header com hambúrguer + título + ícone de calendário.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_tela">

    <!-- Header roxo -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutHeader"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/roxo_primario"
        android:paddingHorizontal="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_nav_menu"
            android:tint="@color/fundo_card"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_medium"
            android:gravity="center"
            android:text="Smart Notebook"
            android:textColor="@color/fundo_card"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnCalendarioIcn"
            app:layout_constraintStart_toEndOf="@id/btnMenu"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btnCalendarioIcn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_nav_calendario"
            android:tint="@color/fundo_card"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Conteúdo rolável: calendário + eventos -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card branco que envolve o calendário (fiel à referência) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/divisoria"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Navegação entre meses: seta esquerda / mês-ano / seta direita -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Seta para mês anterior -->
                        <ImageButton
                            android:id="@+id/btnMesAnterior"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_chevron_left"
                            android:tint="@color/texto_secundario" />

                        <!-- Título do mês e ano (ex: "Outubro 2023") -->
                        <TextView
                            android:id="@+id/tvMesAno"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Outubro 2023"
                            android:textColor="@color/texto_primario"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <!-- Seta para próximo mês -->
                        <ImageButton
                            android:id="@+id/btnProximoMes"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_chevron_right"
                            android:tint="@color/texto_secundario" />
                    </LinearLayout>

                    <!-- Cabeçalho dos dias da semana (letras simples, fiel à referência) -->
                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:columnCount="7">

                        <TextView android:layout_width="0dp" android:layout_columnWeight="1"
                            android:gravity="center" android:text="D"
                            android:textColor="@color/texto_hint" android:textSize="12sp"
                            android:textStyle="bold" android:paddingVertical="8dp" />
                        <TextView android:layout_width="0dp" android:layout_columnWeight="1"
                            android:gravity="center" android:text="S"
                            android:textColor="@color/texto_hint" android:textSize="12sp"
                            android:textStyle="bold" android:paddingVertical="8dp" />
                        <TextView android:layout_width="0dp" android:layout_columnWeight="1"
                            android:gravity="center" android:text="T"
                            android:textColor="@color/texto_hint" android:textSize="12sp"
                            android:textStyle="bold" android:paddingVertical="8dp" />
                        <TextView android:layout_width="0dp" android:layout_columnWeight="1"
                            android:gravity="center" android:text="Q"
                            android:textColor="@color/texto_hint" android:textSize="12sp"
                            android:textStyle="bold" android:paddingVertical="8dp" />
                        <TextView android:layout_width="0dp" android:layout_columnWeight="1"
                            android:gravity="center" android:text="Q"
                            android:textColor="@color/texto_hint" android:textSize="12sp"
                            android:textStyle="bold" android:paddingVertical="8dp" />
                        <TextView android:layout_width="0dp" android:layout_columnWeight="1"
                            android:gravity="center" android:text="S"
                            android:textColor="@color/texto_hint" android:textSize="12sp"
                            android:textStyle="bold" android:paddingVertical="8dp" />
                        <TextView android:layout_width="0dp" android:layout_columnWeight="1"
                            android:gravity="center" android:text="S"
                            android:textColor="@color/texto_hint" android:textSize="12sp"
                            android:textStyle="bold" android:paddingVertical="8dp" />
                    </GridLayout>

                    <!-- Grade do calendário (células criadas via código em CalendarioActivity) -->
                    <GridLayout
                        android:id="@+id/gridCalendario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="7" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Legenda de cores (pontos circulares, fiel à referência) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Ponto vermelho = Avaliação -->
                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_dot_vermelho" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="24dp"
                    android:text="Avaliação"
                    android:textColor="@color/texto_secundario"
                    android:textSize="12sp" />

                <!-- Ponto teal = Atividades -->
                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_dot_teal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Atividades"
                    android:textColor="@color/texto_secundario"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Cabeçalho da lista de eventos do dia selecionado -->
            <TextView
                android:id="@+id/tvDiaSelecionado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Activities • Out 14"
                android:textColor="@color/texto_primario"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Lista de eventos do dia (RecyclerView) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvEventos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </ScrollView>

    <!-- Barra de navegação inferior -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/fundo_card"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/menu_bottom_nav" />

</androidx.constraintlayout.widget.ConstraintLayout>
