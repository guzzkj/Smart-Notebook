<?xml version="1.0" encoding="utf-8"?>
<!--
    TELA 9: Nova Atividade — formulário para cadastrar tarefa ou prova.
    Seletor de tipo (Tarefa/Prova), campos de título, matéria, data, hora e observações.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_tela">

    <!-- Header com voltar e título -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutHeader"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/fundo_card"
        android:paddingHorizontal="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnVoltar"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:scaleType="fitCenter"
            android:padding="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nova Atividade"
            android:textColor="@color/texto_primario"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/inter_medium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Conteúdo rolável -->
    <ScrollView
        android:id="@+id/scrollForm"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/btnSalvarAtividade"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Seletor de tipo: Tarefa / Prova -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_campo"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabTarefa"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_selecionado"
                    android:gravity="center"
                    android:layout_margin="4dp"
                    android:padding="4dp"
                    android:text="Tarefa"
                    android:textColor="@color/fundo_card"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabProva"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Prova"
                    android:textColor="@color/texto_secundario"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Campo: Título da atividade -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Título"
                android:textColor="@color/texto_primario"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etTituloAtividade"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_campo"
                android:hint="Ex: Relatório de Microserviços"
                android:inputType="textCapSentences"
                android:paddingHorizontal="16dp"
                android:textColor="@color/texto_primario"
                android:textColorHint="@color/texto_hint"
                android:textSize="14sp" />

            <!-- Campo: Matéria -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Matéria"
                android:textColor="@color/texto_primario"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerMateria"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_campo"
                android:paddingHorizontal="16dp" />

            <!-- Linha com Data e Hora lado a lado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Data"
                        android:textColor="@color/texto_primario"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etData"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_campo"
                        android:hint="DD/MM/AAAA"
                        android:inputType="date"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/texto_primario"
                        android:textColorHint="@color/texto_hint"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Hora"
                        android:textColor="@color/texto_primario"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etHora"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_campo"
                        android:hint="HH:MM"
                        android:inputType="time"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/texto_primario"
                        android:textColorHint="@color/texto_hint"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Campo: Observações -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Observações (Opcional)"
                android:textColor="@color/texto_primario"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etObservacoes"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@drawable/bg_campo"
                android:gravity="top|start"
                android:hint="Adicione detalhes adicionais..."
                android:inputType="textCapSentences|textMultiLine"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:textColor="@color/texto_primario"
                android:textColorHint="@color/texto_hint"
                android:textSize="14sp" />

        </LinearLayout>
    </ScrollView>

    <!-- Botão Salvar Atividade fixo no rodapé -->
    <Button
        android:id="@+id/btnSalvarAtividade"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/roxo_primario"
        android:text="Salvar Atividade"
        android:textColor="@color/fundo_card"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
