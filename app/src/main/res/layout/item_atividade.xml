<?xml version="1.0" encoding="utf-8"?>
<!--
    Item de atividade (tarefa/prova) para o RecyclerView da tela Detalhes da Matéria.
    Exibe ponto colorido de status, título, tipo/status e data/hora.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_nota"
    android:padding="14dp"
    android:layout_marginBottom="8dp">

    <!-- Ponto colorido de status (vermelho = atrasada, verde = em andamento) -->
    <View
        android:id="@+id/viewDot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/bg_dot"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Título da atividade -->
    <TextView
        android:id="@+id/tvTituloAtividade"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Relatório de Microserviços"
        android:textColor="@color/texto_primario"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="@font/inter_medium"
        app:layout_constraintEnd_toStartOf="@id/tvDataAtividade"
        app:layout_constraintStart_toEndOf="@id/viewDot"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Tipo e status da atividade (ex: "TAREFA • ATRASADA") -->
    <TextView
        android:id="@+id/tvTipoStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        android:text="TAREFA • ATRASADA"
        android:textColor="#EF4444"
        android:textSize="11sp"
        android:textAllCaps="false"
        app:layout_constraintEnd_toStartOf="@id/tvDataAtividade"
        app:layout_constraintStart_toEndOf="@id/viewDot"
        app:layout_constraintTop_toBottomOf="@id/tvTituloAtividade" />

    <!-- Data da atividade -->
    <TextView
        android:id="@+id/tvDataAtividade"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Out 20"
        android:textColor="@color/texto_secundario"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Hora da atividade -->
    <TextView
        android:id="@+id/tvHoraAtividade"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="23:59"
        android:textColor="@color/texto_hint"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDataAtividade" />

</androidx.constraintlayout.widget.ConstraintLayout>
