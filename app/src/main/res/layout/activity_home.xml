<?xml version="1.0" encoding="utf-8"?>
<!--
    TELA 4 – Home / Dashboard Principal
    Tela principal do app após o login. Possui:
    - Header roxo arredondado com saudação e campo de busca
    - Cards de resumo (total de notas, favoritas, categorias)
    - RecyclerView horizontal de notas recentes
    - Atalhos de categorias em grade 2x2
    - BottomNavigationView para navegação entre seções
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_tela">

    <!-- ============================================================
         HEADER com fundo roxo arredondado nas bordas inferiores
         ============================================================ -->
    <LinearLayout
        android:id="@+id/header_home"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_toolbar"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="28dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Linha: saudação + botão de busca -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Textos de boas-vindas -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_ola"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Olá, 👋"
                    android:textColor="#DDEEFF"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter" />

                <TextView
                    android:id="@+id/tv_nome_usuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estudante"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter_medium" />
            </LinearLayout>

            <!-- Ícone de busca no canto superior direito -->
            <ImageView
                android:id="@+id/btn_buscar_home"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_search"
                android:contentDescription="Buscar anotações"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Campo de busca rápida (clicável, abre BuscaActivity) -->
        <LinearLayout
            android:id="@+id/container_busca_home"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_busca"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@android:drawable/ic_menu_search"
                android:contentDescription="Ícone busca" />

            <!-- Texto placeholder clicável -->
            <TextView
                android:id="@+id/tv_busca_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Buscar anotações..."
                android:textColor="@color/texto_hint"
                android:textSize="14sp"
                android:fontFamily="@font/inter"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============================================================
         ÁREA DE CONTEÚDO ROLÁVEL (entre o header e o BottomNav)
         ============================================================ -->
    <ScrollView
        android:id="@+id/scroll_home"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@+id/header_home"
        app:layout_constraintBottom_toTopOf="@+id/bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="16dp">

            <!-- === SEÇÃO: RESUMO === -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resumo"
                android:textColor="@color/texto_primario"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_medium"
                android:layout_marginBottom="12dp" />

            <!-- Três cards de estatísticas lado a lado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <!-- Card: Total de notas → abre NotasActivity -->
                <LinearLayout
                    android:id="@+id/card_total_notas"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_card_nota"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:elevation="2dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_qtd_notas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8"
                        android:textColor="@color/roxo_primario"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/inter_medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Notas"
                        android:textColor="@color/texto_secundario"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter" />
                </LinearLayout>

                <!-- Card: Favoritas → abre FavoritosActivity -->
                <LinearLayout
                    android:id="@+id/card_favoritas"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_card_nota"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:elevation="2dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_qtd_favoritas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3"
                        android:textColor="@color/cor_favorito"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/inter_medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Favoritas"
                        android:textColor="@color/texto_secundario"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter" />
                </LinearLayout>

                <!-- Card: Categorias → abre CategoriasActivity -->
                <LinearLayout
                    android:id="@+id/card_categorias_home"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_nota"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:elevation="2dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_qtd_categorias"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4"
                        android:textColor="@color/roxo_claro"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/inter_medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Categorias"
                        android:textColor="@color/texto_secundario"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter" />
                </LinearLayout>
            </LinearLayout>

            <!-- === SEÇÃO: NOTAS RECENTES === -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Notas Recentes"
                    android:textColor="@color/texto_primario"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter_medium" />

                <!-- Link "Ver todas" → NavegaNavega para NotasActivity -->
                <TextView
                    android:id="@+id/tv_ver_todas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ver todas"
                    android:textColor="@color/roxo_primario"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_medium"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless" />
            </LinearLayout>

            <!-- RecyclerView horizontal de notas recentes (3 itens) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_notas_recentes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:clipToPadding="false"
                android:paddingEnd="16dp" />

            <!-- === SEÇÃO: CATEGORIAS (grade 2x2) === -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Categorias"
                android:textColor="@color/texto_primario"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_medium"
                android:layout_marginBottom="12dp" />

            <!-- Linha 1: Estudo + Trabalho -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:id="@+id/cat_estudo"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_card_nota"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:elevation="2dp"
                    android:paddingHorizontal="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📚 Estudo"
                        android:textColor="@color/cat_estudo_texto"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter_medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5"
                        android:textColor="@color/texto_secundario"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cat_trabalho"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_nota"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:elevation="2dp"
                    android:paddingHorizontal="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="💼 Trabalho"
                        android:textColor="@color/cat_trabalho_texto"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter_medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3"
                        android:textColor="@color/texto_secundario"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Linha 2: Pessoal + Ideias -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cat_pessoal"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_card_nota"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:elevation="2dp"
                    android:paddingHorizontal="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🏠 Pessoal"
                        android:textColor="@color/cat_pessoal_texto"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter_medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2"
                        android:textColor="@color/texto_secundario"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cat_ideias"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_nota"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:elevation="2dp"
                    android:paddingHorizontal="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="💡 Ideias"
                        android:textColor="@color/cat_ideia_texto"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter_medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2"
                        android:textColor="@color/texto_secundario"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ============================================================
         BOTÃO FLUTUANTE (FAB) para criar nova nota
         Fica sobreposto, acima do BottomNav
         ============================================================ -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_nova_nota"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="80dp"
        android:contentDescription="Criar nova anotação"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/roxo_primario"
        app:tint="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- ============================================================
         BARRA DE NAVEGAÇÃO INFERIOR
         Permite navegar entre Início, Notas, Favoritos e Perfil
         ============================================================ -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/fundo_card"
        app:menu="@menu/menu_bottom_nav"
        app:itemIconTint="@color/roxo_primario"
        app:itemTextColor="@color/roxo_primario"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
