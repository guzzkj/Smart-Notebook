<?xml version="1.0" encoding="utf-8"?>
<!--
    TELA 4: Esqueci Minha Senha — recuperação de acesso via e-mail acadêmico.
    Layout centralizado com campo de e-mail e botão de envio de código.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_tela"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="32dp">

        <!-- Ícone de cadeado com fundo roxo claro -->
        <FrameLayout
            android:id="@+id/layoutIcone"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_tag_categoria"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lock_reset"
                android:tint="@color/roxo_primario" />
        </FrameLayout>

        <!-- Título principal -->
        <TextView
            android:id="@+id/tvTituloEsqueceu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="Esqueceu sua senha?"
            android:textColor="@color/texto_primario"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="@font/inter_medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutIcone" />

        <!-- Subtítulo explicativo -->
        <TextView
            android:id="@+id/tvSubtitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Insira seu e-mail cadastrado para receber um código de recuperação."
            android:textColor="@color/texto_secundario"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTituloEsqueceu" />

        <!-- Rótulo do campo de e-mail -->
        <TextView
            android:id="@+id/tvLabelEmail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="E-mail acadêmico"
            android:textColor="@color/texto_primario"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitulo" />

        <!-- Campo de e-mail -->
        <EditText
            android:id="@+id/etEmailRecuperacao"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_campo"
            android:drawableStart="@drawable/ic_email"
            android:drawableTint="@color/texto_hint"
            android:drawablePadding="8dp"
            android:hint="seu.nome@universidade.edu"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="16dp"
            android:textColor="@color/texto_primario"
            android:textColorHint="@color/texto_hint"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvLabelEmail" />

        <!-- Card de aviso de e-mail institucional -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutAviso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_dica"
            android:padding="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etEmailRecuperacao">

            <ImageView
                android:id="@+id/imgAvisoIcn"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_info"
                android:tint="@color/roxo_primario"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Certifique-se de usar o e-mail institucional vinculado à sua conta do Smart Notebook para garantir a segurança dos seus dados."
                android:textColor="@color/roxo_primario"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/imgAvisoIcn"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Botão Enviar Código -->
        <Button
            android:id="@+id/btnEnviarCodigo"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="@color/roxo_primario"
            android:text="Enviar Código"
            android:textColor="@color/fundo_card"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutAviso" />

        <!-- Link para voltar ao login -->
        <TextView
            android:id="@+id/tvVoltarLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="← Voltar para o Login"
            android:textColor="@color/roxo_primario"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnEnviarCodigo" />

        <!-- Rodapé de suporte -->
        <TextView
            android:id="@+id/tvSuporte"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Ainda precisa de ajuda? Contate o suporte"
            android:textColor="@color/texto_hint"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvVoltarLogin" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
