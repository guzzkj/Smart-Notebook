<?xml version="1.0" encoding="utf-8"?>
<!--
    TELA 11 – Busca de Anotações
    Permite pesquisar notas por título ou conteúdo em tempo real.
    Os resultados aparecem no RecyclerView abaixo do campo de busca.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_tela">

    <!-- Header com campo de busca sobre fundo roxo -->
    <LinearLayout
        android:id="@+id/header_busca"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/roxo_primario"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="48dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Linha: botão voltar + título "Buscar" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/btn_voltar_busca"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Voltar"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Buscar"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_medium" />
        </LinearLayout>

        <!-- Campo de texto de busca com fundo branco arredondado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_busca"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@android:drawable/ic_menu_search"
                android:contentDescription="Buscar" />

            <!-- EditText onde o usuário digita a busca -->
            <EditText
                android:id="@+id/et_busca"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@null"
                android:hint="Buscar anotações..."
                android:textColorHint="@color/texto_hint"
                android:textColor="@color/texto_primario"
                android:textSize="15sp"
                android:fontFamily="@font/inter"
                android:inputType="text"
                android:singleLine="true"
                android:imeOptions="actionSearch" />

            <!-- Botão de limpar campo (aparece ao digitar) -->
            <ImageView
                android:id="@+id/btn_limpar_busca"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="Limpar"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Label com o número/texto de resultados -->
    <TextView
        android:id="@+id/tv_label_resultados"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:text="Resultados"
        android:textColor="@color/texto_primario"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="@font/inter_medium"
        app:layout_constraintTop_toBottomOf="@+id/header_busca"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- RecyclerView com os resultados filtrados (reutiliza item_nota.xml) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_resultados_busca"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@+id/tv_label_resultados"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Mensagem exibida quando nenhum resultado é encontrado -->
    <LinearLayout
        android:id="@+id/layout_sem_resultado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/header_busca"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍"
            android:textSize="48sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Nenhum resultado encontrado"
            android:textColor="@color/texto_secundario"
            android:textSize="16sp"
            android:fontFamily="@font/inter_medium" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
