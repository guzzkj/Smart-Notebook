<?xml version="1.0" encoding="utf-8"?>
<!--
    TELA 10 – Configurações
    Permite ao usuário personalizar o app.
    Organizada em grupos: Aparência, Notificações e Sobre.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_tela">

    <!-- Toolbar com botão de voltar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_config"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/roxo_primario"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="Voltar"
        app:title="Configurações"
        app:titleTextColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ScrollView com todos os grupos de configuração -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_config"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="32dp">

            <!-- ===== GRUPO: APARÊNCIA ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="APARÊNCIA"
                android:textColor="@color/roxo_primario"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:fontFamily="@font/inter_medium"
                android:layout_marginBottom="8dp" />

            <!-- Opção: Tema Escuro (com Switch) -->
            <LinearLayout
                android:id="@+id/item_tema_escuro"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_card_nota"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="8dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tema Escuro"
                    android:textColor="@color/texto_primario"
                    android:textSize="15sp"
                    android:fontFamily="@font/inter" />

                <Switch
                    android:id="@+id/switch_tema_escuro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="@color/roxo_primario"
                    android:trackTint="#C5CAE9" />
            </LinearLayout>

            <!-- Opção: Tamanho da Fonte (clicável) -->
            <LinearLayout
                android:id="@+id/item_fonte"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_card_nota"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="24dp"
                android:elevation="2dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tamanho da Fonte"
                    android:textColor="@color/texto_primario"
                    android:textSize="15sp"
                    android:fontFamily="@font/inter" />

                <TextView
                    android:id="@+id/tv_fonte_atual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Médio"
                    android:textColor="@color/texto_secundario"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter" />
            </LinearLayout>

            <!-- ===== GRUPO: NOTIFICAÇÕES ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NOTIFICAÇÕES"
                android:textColor="@color/roxo_primario"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:fontFamily="@font/inter_medium"
                android:layout_marginBottom="8dp" />

            <!-- Opção: Ativar Notificações -->
            <LinearLayout
                android:id="@+id/item_notificacoes"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_card_nota"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="8dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ativar Notificações"
                    android:textColor="@color/texto_primario"
                    android:textSize="15sp"
                    android:fontFamily="@font/inter" />

                <Switch
                    android:id="@+id/switch_notificacoes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:thumbTint="@color/roxo_primario"
                    android:trackTint="#C5CAE9" />
            </LinearLayout>

            <!-- Opção: Lembrete de Revisão -->
            <LinearLayout
                android:id="@+id/item_lembrete"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_card_nota"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="24dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Lembrete de Revisão"
                    android:textColor="@color/texto_primario"
                    android:textSize="15sp"
                    android:fontFamily="@font/inter" />

                <Switch
                    android:id="@+id/switch_lembrete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="@color/roxo_primario"
                    android:trackTint="#C5CAE9" />
            </LinearLayout>

            <!-- ===== GRUPO: SOBRE ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SOBRE"
                android:textColor="@color/roxo_primario"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:fontFamily="@font/inter_medium"
                android:layout_marginBottom="8dp" />

            <!-- Versão do app (apenas informativa) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_card_nota"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Versão do App"
                    android:textColor="@color/texto_primario"
                    android:textSize="15sp"
                    android:fontFamily="@font/inter" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.0.0"
                    android:textColor="@color/texto_secundario"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
