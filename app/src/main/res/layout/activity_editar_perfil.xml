<?xml version="1.0" encoding="utf-8"?>
<!--
    TELA 12: Editar Perfil — permite alterar nome, e-mail e foto do usuário.
    Avatar com badge de câmera, campos de texto e botão de salvar.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_tela"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Header com voltar e título -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutHeader"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:background="@color/fundo_card"
            android:paddingHorizontal="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnVoltar"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:scaleType="fitCenter"
                android:padding="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Editar Perfil"
                android:textColor="@color/texto_primario"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_medium"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Seção do avatar com badge de câmera -->
        <FrameLayout
            android:id="@+id/layoutAvatar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutHeader">

            <!-- Foto do perfil (avatar grande) -->
            <ImageView
                android:id="@+id/imgAvatarPerfil"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_avatar"
                android:padding="20dp"
                android:src="@android:drawable/ic_menu_myplaces"
                android:tint="#94A3B8" />

            <!-- Badge de câmera (verde) -->
            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="bottom|end"
                android:background="#22C55E"
                android:layout_marginEnd="2dp"
                android:layout_marginBottom="2dp"
                android:backgroundTint="#22C55E">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_camera"
                    android:tint="@color/fundo_card" />
            </FrameLayout>
        </FrameLayout>

        <!-- Link "Alterar foto" -->
        <TextView
            android:id="@+id/tvAltararFoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Alterar foto"
            android:textColor="@color/roxo_primario"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutAvatar" />

        <!-- Formulário com os campos do perfil -->
        <LinearLayout
            android:id="@+id/layoutForm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvAltararFoto">

            <!-- Campo: Nome Completo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Nome Completo"
                android:textColor="@color/texto_primario"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNomeCompleto"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_campo"
                android:paddingHorizontal="16dp"
                android:text="Carlos Eduardo Silva"
                android:textColor="@color/texto_primario"
                android:textSize="15sp"
                android:inputType="textPersonName|textCapWords" />

            <!-- Campo: E-mail -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="E-mail"
                android:textColor="@color/texto_primario"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEmailPerfil"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="32dp"
                android:background="@drawable/bg_campo"
                android:paddingHorizontal="16dp"
                android:text="carlos.eduardo@smartcaderno.com"
                android:textColor="@color/texto_primario"
                android:textSize="15sp"
                android:inputType="textEmailAddress" />

            <!-- Botão Salvar Alterações -->
            <Button
                android:id="@+id/btnSalvarAlteracoes"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="@color/roxo_primario"
                android:drawableStart="@android:drawable/ic_menu_save"
                android:drawableTint="@color/fundo_card"
                android:drawablePadding="8dp"
                android:text="Salvar Alterações"
                android:textColor="@color/fundo_card"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Informação de sincronização -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Suas informações serão sincronizadas com todos os seus dispositivos do SmartCaderno."
                android:textColor="@color/texto_hint"
                android:textSize="12sp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
